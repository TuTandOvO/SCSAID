<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://java.sun.com/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd"
         version="3.0"
         metadata-complete="true">
    <context-param>
        <param-name>skindbDataRoot</param-name>
        <param-value>/opt/SkinDB</param-value>
    </context-param>

    <!-- Cloudflare Turnstile public site key for the feedback gate.
         Leave blank to disable the gate (form shows directly).
         Overridable at runtime by the TURNSTILE_SITE_KEY env var. -->
    <context-param>
        <param-name>turnstileSiteKey</param-name>
        <param-value></param-value>
    </context-param>

    <filter>
        <filter-name>AccessCounterFilter</filter-name>
        <filter-class>AccessCounter.AccessCounterFilter</filter-class>
        <init-param>
            <param-name>counterFile</param-name>
            <param-value>/opt/SkinDB/runtime/access-counter.properties</param-value>
        </init-param>
        <init-param>
            <param-name>trafficHistoryFile</param-name>
            <param-value>/opt/SkinDB/runtime/traffic-history.properties</param-value>
        </init-param>
        <!-- Country-only aggregates. The GeoLite database is deployed outside
             the WAR so an IP address is resolved locally and never exported. -->
        <init-param>
            <param-name>countryTrafficFile</param-name>
            <param-value>/opt/SkinDB/runtime/country-traffic.properties</param-value>
        </init-param>
        <init-param>
            <param-name>countryTrafficRetentionDays</param-name>
            <param-value>365</param-value>
        </init-param>
        <init-param>
            <param-name>developerVisitorFile</param-name>
            <param-value>/opt/SkinDB/runtime/developer-visitor-addresses.properties</param-value>
        </init-param>
        <init-param>
            <param-name>developerVisitEventsFile</param-name>
            <param-value>/opt/SkinDB/runtime/developer-visit-events.tsv</param-value>
        </init-param>
        <init-param>
            <param-name>geoIpDatabase</param-name>
            <param-value>/opt/SkinDB/runtime/GeoLite2-City.mmdb</param-value>
        </init-param>
    </filter>
    <filter-mapping>
        <filter-name>AccessCounterFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- The dashboard and its JSON endpoint remain invisible unless the
         deployment supplies both SCSAID_ANALYTICS_USER and _PASSWORD. -->
    <filter>
        <filter-name>DeveloperAnalyticsFilter</filter-name>
        <filter-class>AccessCounter.DeveloperAnalyticsFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>DeveloperAnalyticsFilter</filter-name>
        <url-pattern>/developer-traffic.jsp</url-pattern>
        <url-pattern>/country-traffic-stats</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>SecurityHeadersFilter</filter-name>
        <filter-class>Utils.SecurityHeadersFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>SecurityHeadersFilter</filter-name>
        <url-pattern>/*</url-pattern>
        <dispatcher>REQUEST</dispatcher>
        <dispatcher>ERROR</dispatcher>
    </filter-mapping>

    <!-- Per-client-IP rate limiting for abuse-prone / compute-heavy endpoints -->
    <filter>
        <filter-name>RateLimitFilter</filter-name>
        <filter-class>Utils.RateLimitFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>RateLimitFilter</filter-name>
        <url-pattern>/visualization</url-pattern>
        <url-pattern>/enrichment</url-pattern>
        <url-pattern>/integrate</url-pattern>
        <url-pattern>/deg</url-pattern>
        <url-pattern>/gene-search</url-pattern>
        <url-pattern>/condition-deg-search</url-pattern>
        <url-pattern>/condition-deg-search/status</url-pattern>
        <url-pattern>/gene-details</url-pattern>
        <url-pattern>/ai-interpretation</url-pattern>
        <url-pattern>/cpdb-api</url-pattern>
        <url-pattern>/condition-compare</url-pattern>
        <url-pattern>/condition-compare/status</url-pattern>
        <url-pattern>/condition-compare/result</url-pattern>
        <url-pattern>/condition-gsea</url-pattern>
        <url-pattern>/condition-gsea/status</url-pattern>
        <url-pattern>/condition-gsea/result</url-pattern>
        <url-pattern>/deg-compare</url-pattern>
        <url-pattern>/deg-compare/status</url-pattern>
        <url-pattern>/deg-compare/result</url-pattern>
        <url-pattern>/deg-per-celltype</url-pattern>
        <url-pattern>/deg-per-celltype/status</url-pattern>
        <url-pattern>/deg-per-celltype/result</url-pattern>
        <url-pattern>/scorpion</url-pattern>
        <url-pattern>/psospotter</url-pattern>
        <url-pattern>/psospotter/status</url-pattern>
        <url-pattern>/psospotter/result</url-pattern>
        <url-pattern>/details.jsp</url-pattern>
    </filter-mapping>

    <servlet>
        <servlet-name>TrafficStatsServlet</servlet-name>
        <servlet-class>AccessCounter.TrafficStatsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TrafficStatsServlet</servlet-name>
        <url-pattern>/traffic-stats</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>CountryTrafficStatsServlet</servlet-name>
        <servlet-class>AccessCounter.CountryTrafficStatsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CountryTrafficStatsServlet</servlet-name>
        <url-pattern>/country-traffic-stats</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>home</servlet-name>
        <servlet-class>Servlet.home</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>home</servlet-name>
        <url-pattern>/home</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>browse</servlet-name>
        <servlet-class>Servlet.browse</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>browse</servlet-name>
        <url-pattern>/browse</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>details</servlet-name>
        <servlet-class>Servlet.details</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>details</servlet-name>
        <url-pattern>/details</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DEGServlet</servlet-name>
        <servlet-class>Servlet.DEGServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DEGServlet</servlet-name>
        <url-pattern>/deg</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>GeneSearchServlet</servlet-name>
        <servlet-class>Servlet.GeneSearchServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>GeneSearchServlet</servlet-name>
        <url-pattern>/gene-search</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AtlasContextServlet</servlet-name>
        <servlet-class>Servlet.AtlasContextServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AtlasContextServlet</servlet-name>
        <url-pattern>/atlas-context</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>SiteSearchServlet</servlet-name>
        <servlet-class>Servlet.SiteSearchServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SiteSearchServlet</servlet-name>
        <url-pattern>/site-search</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>GeneDetailsServlet</servlet-name>
        <servlet-class>Servlet.GeneDetailsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>GeneDetailsServlet</servlet-name>
        <url-pattern>/gene-details</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>VisualizationServlet</servlet-name>
        <servlet-class>Servlet.VisualizationServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>VisualizationServlet</servlet-name>
        <url-pattern>/visualization</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AIInterpretationServlet</servlet-name>
        <servlet-class>Servlet.AIInterpretationServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AIInterpretationServlet</servlet-name>
        <url-pattern>/ai-interpretation</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DownloadServlet</servlet-name>
        <servlet-class>Servlet.DownloadServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DownloadServlet</servlet-name>
        <url-pattern>/download-file</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>feedback</servlet-name>
        <servlet-class>Servlet.feedback</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>feedback</servlet-name>
        <url-pattern>/feedback</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>help</servlet-name>
        <servlet-class>Servlet.help</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>help</servlet-name>
        <url-pattern>/help</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>contact</servlet-name>
        <servlet-class>Servlet.contact</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>contact</servlet-name>
        <url-pattern>/contact</url-pattern>
    </servlet-mapping>

    <mime-mapping>
        <extension>md</extension>
        <mime-type>text/markdown</mime-type>
    </mime-mapping>

    <error-page>
        <error-code>404</error-code>
        <location>/404.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/error.jsp</location>
    </error-page>
    <error-page>
        <exception-type>java.lang.Throwable</exception-type>
        <location>/error.jsp</location>
    </error-page>

    <!-- Harden session cookie: not script-accessible, HTTPS-only -->
    <session-config>
        <cookie-config>
            <http-only>true</http-only>
            <secure>true</secure>
        </cookie-config>
    </session-config>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>
    <servlet>
        <servlet-name>EnrichmentServlet</servlet-name>
        <servlet-class>Servlet.EnrichmentServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>EnrichmentServlet</servlet-name>
        <url-pattern>/enrichment</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>ScorpionServlet</servlet-name>
        <servlet-class>Servlet.ScorpionServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ScorpionServlet</servlet-name>
        <url-pattern>/scorpion</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>GeoMetaServlet</servlet-name>
        <servlet-class>Servlet.GeoMetaServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>GeoMetaServlet</servlet-name>
        <url-pattern>/geo_meta</url-pattern>
    </servlet-mapping>

    <!-- Annotation scanning is disabled by metadata-complete="true", so every
         production servlet must be declared explicitly. -->
    <servlet>
        <servlet-name>CellPhoneDBServlet</servlet-name>
        <servlet-class>Servlet.CellPhoneDBServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>CellPhoneDBServlet</servlet-name>
        <url-pattern>/cpdb-api</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DEGCompareServlet</servlet-name>
        <servlet-class>Servlet.DEGCompareServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DEGCompareServlet</servlet-name>
        <url-pattern>/datasets</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>DEGCompareServlet</servlet-name>
        <url-pattern>/deg-compare</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>DEGCompareServlet</servlet-name>
        <url-pattern>/deg-compare/status</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>DEGCompareServlet</servlet-name>
        <url-pattern>/deg-compare/result</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>DEGCompareServlet</servlet-name>
        <url-pattern>/deg-per-celltype</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>DEGCompareServlet</servlet-name>
        <url-pattern>/deg-per-celltype/status</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>DEGCompareServlet</servlet-name>
        <url-pattern>/deg-per-celltype/result</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ConditionCompareServlet</servlet-name>
        <servlet-class>Servlet.ConditionCompareServlet</servlet-class>
    </servlet>
    <servlet-mapping><servlet-name>ConditionCompareServlet</servlet-name><url-pattern>/conditions</url-pattern></servlet-mapping>
    <servlet-mapping><servlet-name>ConditionCompareServlet</servlet-name><url-pattern>/condition-compare</url-pattern></servlet-mapping>
    <servlet-mapping><servlet-name>ConditionCompareServlet</servlet-name><url-pattern>/condition-compare/status</url-pattern></servlet-mapping>
    <servlet-mapping><servlet-name>ConditionCompareServlet</servlet-name><url-pattern>/condition-compare/result</url-pattern></servlet-mapping>
    <servlet-mapping><servlet-name>ConditionCompareServlet</servlet-name><url-pattern>/condition-gsea</url-pattern></servlet-mapping>
    <servlet-mapping><servlet-name>ConditionCompareServlet</servlet-name><url-pattern>/condition-gsea/status</url-pattern></servlet-mapping>
    <servlet-mapping><servlet-name>ConditionCompareServlet</servlet-name><url-pattern>/condition-gsea/result</url-pattern></servlet-mapping>
    <servlet-mapping><servlet-name>ConditionCompareServlet</servlet-name><url-pattern>/gmt-catalog</url-pattern></servlet-mapping>

    <servlet>
        <servlet-name>ConditionDegSearchServlet</servlet-name>
        <servlet-class>Servlet.ConditionDegSearchServlet</servlet-class>
    </servlet>
    <servlet-mapping><servlet-name>ConditionDegSearchServlet</servlet-name><url-pattern>/condition-deg-search</url-pattern></servlet-mapping>
    <servlet-mapping><servlet-name>ConditionDegSearchServlet</servlet-name><url-pattern>/condition-deg-search/status</url-pattern></servlet-mapping>

    <servlet>
        <servlet-name>PsoSpotterServlet</servlet-name>
        <servlet-class>Servlet.PsoSpotterServlet</servlet-class>
        <multipart-config>
            <location>/tmp</location>
            <max-file-size>262144000</max-file-size>
            <max-request-size>524288000</max-request-size>
            <file-size-threshold>1048576</file-size-threshold>
        </multipart-config>
    </servlet>
    <servlet-mapping>
        <servlet-name>PsoSpotterServlet</servlet-name>
        <url-pattern>/psospotter</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>PsoSpotterServlet</servlet-name>
        <url-pattern>/psospotter/status</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>PsoSpotterServlet</servlet-name>
        <url-pattern>/psospotter/result</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>compareJsp</servlet-name>
        <jsp-file>/compare.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>compareJsp</servlet-name>
        <url-pattern>/compare</url-pattern>
    </servlet-mapping>

    <!-- UTF-8 is the site-wide JSP default. Individual pages may override the
         MIME type (for example, sitemap.jsp uses XML) while retaining UTF-8. -->
    <jsp-config>
        <jsp-property-group>
            <url-pattern>*.jsp</url-pattern>
            <page-encoding>UTF-8</page-encoding>
            <default-content-type>text/html; charset=UTF-8</default-content-type>
        </jsp-property-group>
    </jsp-config>

</web-app>
